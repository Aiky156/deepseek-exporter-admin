# ========================================================
# DeepSeek Exporter Admin (DSE Admin)
# 环境变量配置参考模板
# 部署至 Vercel 时在 Project Settings -> Environment Variables 添加
# ========================================================

# 1. Supabase 连接（与主站相同的 Supabase 项目）
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# 2. 管理面板通行密码（打开管理后台时输入该密码即可登入）
ADMIN_PASSWORD=your_custom_admin_password

# 3. Session Cookie 签名密钥（任意长随机字符串，用于安全防伪造）
COOKIE_SECRET=your_random_secret_string_minimum_32_characters
